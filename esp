-- Funç��o que aplica highlight a um personagem de jogador
function esp(target, color)
    if target.Character then
        if not target.Character:FindFirstChild("GetReal") then
            local highlight = Instance.new("Highlight")
            highlight.RobloxLocked = true
            highlight.Name = "GetReal"
            highlight.Adornee = target.Character
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillColor = color
            highlight.Parent = target.Character
        else
            target.Character.GetReal.FillColor = color
        end
    end
end

-- Funções para NPCs (modelos no Workspace com Humanoid que NÃO são personagens de players)
local function isPlayerCharacter(model)
    if not model or not model:IsA("Model") then return false end
    return players:GetPlayerFromCharacter(model) ~= nil
end

local function hasHumanoid(model)
    if not model or not model:IsA("Model") then return false end
    -- procura humanoid diretamente entre filhos do Model
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function applyNPCHighlight(model, color)
    if not model or not model.Parent or not hasHumanoid(model) then return end
    if isPlayerCharacter(model) then return end -- ignora personagens de jogadores
    if model:FindFirstChild("GetRealNPC") then
        model.GetRealNPC.FillColor = color
        return
    end
    local success, _ = pcall(function()
        local highlight = Instance.new("Highlight")
        highlight.RobloxLocked = true
        highlight.Name = "GetRealNPC"
        highlight.Adornee = model
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = color
        highlight.Parent = model
    end)
    return success
end

local function removeNPCHighlight(model)
    if not model then return end
    local h = model:FindFirstChild("GetRealNPC")
    if h and h.Destroy then
        h:Destroy()
    end
end

