    -- NPCs
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and hasHumanoid(obj) and not isPlayerCharacter(obj) then
            applyNPCHighlight(obj, _G.NPCColor)
        end
    end

    -- Itens (reaplica cor aos já processados, caso queira mudar _G.ItemColor dinamicamente)
    for itemObj, _ in pairs(processedItems) do
        if itemObj and itemObj.Parent then
            if itemObj:FindFirstChild("GetRealItem") then
                itemObj.GetRealItem.FillColor = _G.ItemColor
            else
                applyItemHighlight(itemObj, _G.ItemColor)
            end
        else
            -- item removido
            processedItems[itemObj] = nil
        end
    end
end
