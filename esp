-- ITENS em RuntimeItems (Deadrails exemplo):
-- Observa Workspace.RuntimeItems e aplica highlight nos itens (top-level children)
local runtimeFolderName = "RuntimeItems"
local runtime = workspace:FindFirstChild(runtimeFolderName)
local processedItems = {} -- mapa de rootItem -> true

local function applyItemHighlight(root, color)
    if not root then return end
    -- evita highlight em personagens e NPCs (somente itens)
    if root:IsA("Model") and players:GetPlayerFromCharacter(root) then return end
    if root:FindFirstChild("GetRealItem") then
        root.GetRealItem.FillColor = color
        processedItems[root] = true
        return
    end
    local ok, _ = pcall(function()
        local highlight = Instance.new("Highlight")
        highlight.RobloxLocked = true
        highlight.Name = "GetRealItem"
        -- Adornee aceita Model ou BasePart — highlight no root item é ideal
        highlight.Adornee = root
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = color
        highlight.Parent = root
    end)
    if ok then
        processedItems[root] = true
    end
end

local function removeItemHighlight(root)
    if not root then return end
    local h = root:FindFirstChild("GetRealItem")
    if h and h.Destroy then
        h:Destroy()
    end
    processedItems[root] = nil
end

local function attachRuntimeListeners(rtf)
    if not rtf then return end

    -- inicial: aplica em cada top-level child (ex: RuntimeItems.GoldBar)
    for _, child in ipairs(rtf:GetChildren()) do
        applyItemHighlight(child, _G.ItemColor)
    end

    -- quando um top-level child for adicionado/ removido
    rtf.ChildAdded:Connect(function(child)
        applyItemHighlight(child, _G.ItemColor)
    end)
    rtf.ChildRemoved:Connect(function(child)
        removeItemHighlight(child)
    end)

    -- também observa se um filho já existente criar/remover sub-objetos relevantes
    -- (não estritamente necessário, mas ajuda caso o item seja construído depois)
    rtf.DescendantAdded:Connect(function(desc)
        local root = desc
        -- sobe até o top-level que é filho direto de RuntimeItems
        while root and root.Parent and root.Parent ~= rtf do
            root = root.Parent
        end
        if root and root.Parent == rtf then
            applyItemHighlight(root, _G.ItemColor)
        end
    end)
    rtf.DescendantRemoving:Connect(function(desc)
        local root = desc
        while root and root.Parent and root.Parent ~= rtf do
            root = root.Parent
        end
        if root and root.Parent == rtf then
            -- se root deixou de existir, remove highlight
            if not root.Parent then
                removeItemHighlight(root)
            end
        end
    end)
end

-- se RuntimeItems já existir ao iniciar, anexa listeners
if runtime then
    attachRuntimeListeners(runtime)
else
    -- aguarda criação do RuntimeItems (caso seja criado depois)
    workspace.ChildAdded:Connect(function(c)
        if c.Name == runtimeFolderName then
            runtime = c
            attachRuntimeListeners(runtime)
        end
    end)
end

